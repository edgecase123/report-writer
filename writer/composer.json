{
    "name": "edgecase123/report-writer",
    "version": "0.1.0",
    "description": "Deterministic reporting pipeline: Fill → Layout → Stream → Render. Framework-agnostic.",
    "type": "library",
    "authors": [
        {
            "name": "edgecase",
            "email": "edgecase123@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5"
    },
    "autoload": {
        "psr-4": {
